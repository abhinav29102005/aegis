{
  "name": "@aegis-platform/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for AEGIS (AgentPay Guardian, GhostPay, DisputeOS).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./integrations/vercel-ai": {
      "types": "./dist/integrations/vercel-ai.d.ts",
      "default": "./dist/integrations/vercel-ai.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && vitest run && node --test tests/sdk.test.mjs",
    "test:vitest": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
