# =============================================================================
# AEGIS Residency Overlay — India (DPDP Act 2023 / RBI Data Localization)
# Copy and merge into /etc/aegis/.env for India-hosted deployments.
# Keeps financial ledger + dispute evidence strictly inside ap-south-1.
# =============================================================================

APP_ENV=production
LOG_LEVEL=INFO
AEGIS_DATA_RESIDENCY=IN

# India-hosted Managed PostgreSQL 16 (SSL required)
POSTGRES_USER=aegis_in
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_IN_DB_PASSWORD
POSTGRES_DB=aegis_in_prod
DATABASE_URL=postgresql+psycopg://aegis_in:REPLACE_WITH_STRONG_IN_DB_PASSWORD@in-postgres.internal:5432/aegis_in_prod?sslmode=require

REDIS_URL=redis://redis:6379/0

# Distinct strong secrets (`openssl rand -hex 32`)
NEXUS_SIGNING_SECRET=REPLACE_WITH_IN_SIGNING_SECRET_MIN_32_CHARS
JWT_SECRET=REPLACE_WITH_DISTINCT_IN_JWT_SECRET_MIN_32_CHARS
NEXUS_API_KEY=REPLACE_WITH_IN_SERVICE_API_KEY
EMAIL_VERIFICATION_REQUIRED=true

CORS_ORIGINS=https://in.app.aegis.example.com
WEBHOOK_REQUIRE_HTTPS=true
WEBHOOK_LEGACY_SIGNATURE_FALLBACK=false

# India Object Storage (ap-south-1 with WORM Object Lock)
AEGIS_STORAGE_BACKEND=s3
AEGIS_S3_BUCKET=aegis-evidence-ap-south-1
AEGIS_S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
AEGIS_S3_REGION=ap-south-1
AEGIS_S3_KEY_PREFIX=in-dpdpa/
AEGIS_S3_OBJECT_LOCK_MODE=COMPLIANCE
AEGIS_S3_RETENTION_DAYS=2920

NEXT_PUBLIC_API_BASE_URL=https://in.api.aegis.example.com
NEXT_PUBLIC_APP_NAME=AEGIS India
