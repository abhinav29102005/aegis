# =============================================================================
# AEGIS Residency Overlay — EU (GDPR)
# Copy and merge into /etc/aegis/.env for EU-hosted deployments.
# Requires EU PostgreSQL + EU S3 bucket with Object Lock enabled.
# =============================================================================

APP_ENV=production
LOG_LEVEL=INFO
AEGIS_DATA_RESIDENCY=EU

# EU-hosted Managed PostgreSQL 16 (SSL required)
POSTGRES_USER=aegis_eu
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_EU_DB_PASSWORD
POSTGRES_DB=aegis_eu_prod
DATABASE_URL=postgresql+psycopg://aegis_eu:REPLACE_WITH_STRONG_EU_DB_PASSWORD@eu-postgres.internal:5432/aegis_eu_prod?sslmode=require

REDIS_URL=redis://redis:6379/0

# Distinct strong secrets (`openssl rand -hex 32`)
NEXUS_SIGNING_SECRET=REPLACE_WITH_EU_SIGNING_SECRET_MIN_32_CHARS
JWT_SECRET=REPLACE_WITH_DISTINCT_EU_JWT_SECRET_MIN_32_CHARS
NEXUS_API_KEY=REPLACE_WITH_EU_SERVICE_API_KEY
EMAIL_VERIFICATION_REQUIRED=true

CORS_ORIGINS=https://eu.app.aegis.example.com
WEBHOOK_REQUIRE_HTTPS=true
WEBHOOK_LEGACY_SIGNATURE_FALLBACK=false

# EU Object Storage (S3 Object Lock WORM)
AEGIS_STORAGE_BACKEND=s3
AEGIS_S3_BUCKET=aegis-evidence-eu-central-1
AEGIS_S3_ENDPOINT_URL=https://s3.eu-central-1.amazonaws.com
AEGIS_S3_REGION=eu-central-1
AEGIS_S3_KEY_PREFIX=eu-gdpr/
AEGIS_S3_OBJECT_LOCK_MODE=COMPLIANCE
AEGIS_S3_RETENTION_DAYS=2555

NEXT_PUBLIC_API_BASE_URL=https://eu.api.aegis.example.com
NEXT_PUBLIC_APP_NAME=AEGIS EU
