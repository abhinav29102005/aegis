# =============================================================================
# AEGIS Residency Overlay — US East
# Copy and merge into /etc/aegis/.env for US-hosted deployments.
# =============================================================================

APP_ENV=production
LOG_LEVEL=INFO
AEGIS_DATA_RESIDENCY=US

# US-East Managed PostgreSQL 16 (SSL required)
POSTGRES_USER=aegis_us
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_US_DB_PASSWORD
POSTGRES_DB=aegis_us_prod
DATABASE_URL=postgresql+psycopg://aegis_us:REPLACE_WITH_STRONG_US_DB_PASSWORD@us-postgres.internal:5432/aegis_us_prod?sslmode=require

REDIS_URL=redis://redis:6379/0

# Distinct strong secrets (`openssl rand -hex 32`)
NEXUS_SIGNING_SECRET=REPLACE_WITH_US_SIGNING_SECRET_MIN_32_CHARS
JWT_SECRET=REPLACE_WITH_DISTINCT_US_JWT_SECRET_MIN_32_CHARS
NEXUS_API_KEY=REPLACE_WITH_US_SERVICE_API_KEY
EMAIL_VERIFICATION_REQUIRED=true

CORS_ORIGINS=https://us.app.aegis.example.com
WEBHOOK_REQUIRE_HTTPS=true
WEBHOOK_LEGACY_SIGNATURE_FALLBACK=false

# US-East Object Storage (S3 Object Lock WORM)
AEGIS_STORAGE_BACKEND=s3
AEGIS_S3_BUCKET=aegis-evidence-us-east-1
AEGIS_S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
AEGIS_S3_REGION=us-east-1
AEGIS_S3_KEY_PREFIX=us-east/
AEGIS_S3_OBJECT_LOCK_MODE=COMPLIANCE
AEGIS_S3_RETENTION_DAYS=2555

NEXT_PUBLIC_API_BASE_URL=https://us.api.aegis.example.com
NEXT_PUBLIC_APP_NAME=AEGIS US
