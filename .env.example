# =============================================================================
# AgentPay Nexus — Environment Configuration
# Copy to .env for local development. Never commit .env with real credentials.
# =============================================================================

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (Canonical Financial Ledger)
DATABASE_URL=postgresql+psycopg://agentpay:agentpay_dev@localhost:5432/agentpay_nexus
POSTGRES_USER=agentpay
POSTGRES_PASSWORD=agentpay_dev
POSTGRES_DB=agentpay_nexus

# Security & Integrity
# Generate strong random hex strings for production (e.g. `openssl rand -hex 32`)
NEXUS_SIGNING_SECRET=dev-only-change-in-production-signing-secret
NEXUS_API_KEY=dev-nexus-api-key
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001

# PayPal Sandbox (Server-side only — NEVER expose client secret to browser)
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_DISPUTES_API_ENABLED=false

# AI / LLM (Optional — deterministic fallback works without credentials)
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=deterministic

# Frontend (Public variables only)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_APP_NAME=AgentPay Nexus

