# =============================================================================
# AEGIS — Agentic Enforcement, Governance and Investigation System
# Copy to .env for local development. NEVER commit .env with real credentials.
# =============================================================================

# Application & CORS
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3005
CORS_ORIGINS=http://localhost:3005,http://localhost:3000

# PostgreSQL 16 (Canonical Multi-Tenant Financial Ledger — loopback-bound in Compose)
POSTGRES_PORT=5432
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_password
POSTGRES_DB=aegis_platform
DATABASE_URL=postgresql+psycopg://aegis:aegis_dev_password@localhost:5432/aegis_platform

# Redis 7 (Distributed Rate-Limiting & Ephemeral Cache — loopback-bound in Compose)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security, Auth & Hash-Chain Secrets
# In staging/production (APP_ENV=staging|production), all three MUST be strong
# distinct random secrets (`openssl rand -hex 32`), and JWT_SECRET != NEXUS_SIGNING_SECRET.
NEXUS_SIGNING_SECRET=dev-only-change-in-production-signing-secret
JWT_SECRET=dev-only-change-in-production-jwt-secret
NEXUS_API_KEY=dev-nexus-api-key
JWT_ACCESS_TTL_MINUTES=480
RATE_LIMIT_RPM=240
EMAIL_VERIFICATION_REQUIRED=false

# Data Residency & Compliance Region (US | EU | IN)
AEGIS_DATA_RESIDENCY=US

# Evidence Object Storage (local | s3)
AEGIS_STORAGE_BACKEND=local
EVIDENCE_STORAGE_DIR=./.aegis_data/evidence
AEGIS_S3_BUCKET=
AEGIS_S3_ENDPOINT_URL=
AEGIS_S3_REGION=us-east-1
AEGIS_S3_ACCESS_KEY_ID=
AEGIS_S3_SECRET_ACCESS_KEY=
AEGIS_S3_KEY_PREFIX=
AEGIS_S3_OBJECT_LOCK_MODE=
AEGIS_S3_RETENTION_DAYS=

# Durable Outbox Worker
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_MAX_ATTEMPTS=5
WORKER_MAX_CONCURRENT_WEBHOOKS=10

# PayPal Sandbox / Live (Server-side only — NEVER expose client secret to browser)
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_DISPUTES_API_ENABLED=false

# Stripe Payment Rail (Optional — Server-side only)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Webhook Transport & Legacy Signature Compatibility
# WEBHOOK_REQUIRE_HTTPS defaults to true in staging/production.
WEBHOOK_REQUIRE_HTTPS=false
# Keep false unless migrating existing unsigned/legacy HMAC webhook integrations.
WEBHOOK_LEGACY_SIGNATURE_FALLBACK=false

# AI / LLM (Optional — deterministic evidence fallback works without credentials)
LLM_PROVIDER=deterministic
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Observability (Prometheus /metrics & OpenTelemetry OTLP)
OTEL_SERVICE_NAME=aegis-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# Frontend (Public variables only)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_APP_NAME=AEGIS
